# The clinic host every tenant subdomain hangs off. Point this at your machine's
# LAN address when testing on a real phone (for example 192.168.1.50.nip.io).
EXPO_PUBLIC_BASE_DOMAIN=localhost

# Where the Laravel app is served.
EXPO_PUBLIC_API_PORT=8000
EXPO_PUBLIC_API_SCHEME=http

# Dev convenience: quick-pick clinics on the tenant picker, so the app is
# usable on an emulator where no QR code can be scanned.
EXPO_PUBLIC_TENANTS=metro,cityclinic,globalexpress
